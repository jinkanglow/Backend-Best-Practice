{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "control_id",
      "result",
      "method",
      "observed_at",
      "artifact",
      "artifact_sha256",
      "observation"
    ],
    "properties": {
      "control_id": {
        "type": "string",
        "pattern": "^BE-[0-9]{2}-[0-9]{2}$"
      },
      "result": {
        "enum": [
          "pass",
          "fail",
          "not_applicable"
        ]
      },
      "method": {
        "enum": [
          "automated_test",
          "manual_review"
        ]
      },
      "observed_at": {
        "type": "string",
        "format": "date-time"
      },
      "artifact": {
        "type": "string",
        "minLength": 1
      },
      "artifact_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "observation": {
        "type": "string",
        "minLength": 1
      },
      "justification": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
