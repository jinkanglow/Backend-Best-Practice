{
  "schema_version": "3.1",
  "engine": "postgres",
  "connection_env": "BGA_TRANSACTION_TEST_URL",
  "test_database_acknowledged": true,
  "allow_mutation_on_test_database": true,
  "cases": [
    {
      "id": "two-connection-read-committed",
      "kind": "non_repeatable_read",
      "isolation": "read_committed",
      "control_ids": ["BE-04-01"],
      "steps": [
        {"id": "a-begin", "session": "a", "action": "begin"},
        {"id": "b-begin", "session": "b", "action": "begin"},
        {"id": "a-read", "session": "a", "action": "query", "sql": "SELECT 1 AS value", "assert": {"first_row": {"value": 1}}},
        {"id": "b-read", "session": "b", "action": "query", "sql": "SELECT 1 AS value", "assert": {"first_row": {"value": 1}}},
        {"id": "b-rollback", "session": "b", "action": "rollback"},
        {"id": "a-rollback", "session": "a", "action": "rollback"}
      ],
      "expected": {"outcome": "observed", "assertion_step": "a-read"}
    }
  ]
}
