    {
      "id": "lost_update",
      "kind": "lost_update",
      "isolation": "read_committed",
      "control_ids": [
        "BE-05-04"
      ],
      "setup": [
        {
          "sql": "DELETE FROM bga_v35 WHERE id IN (1,2,3)"
        },
        {
          "sql": "INSERT INTO bga_v35(id,value) VALUES ($1,$2)",
          "params": [
            1,
            10
          ]
        }
      ],
      "cleanup": [
        {
          "sql": "DELETE FROM bga_v35 WHERE id IN (1,2,3)"
        }
      ],
      "steps": [
        {
          "session": "a",
          "action": "begin"
        },
        {
          "session": "b",
          "action": "begin"
        },
        {
          "session": "a",
          "action": "query",
          "sql": "SELECT id, value FROM bga_v35 WHERE id = 1 ORDER BY id",
          "params": [],
          "expected": [
            {
              "id": 1,
              "value": 10
            }
          ]
        },
        {
          "session": "b",
          "action": "query",
          "sql": "SELECT id, value FROM bga_v35 WHERE id = 1 ORDER BY id",
          "params": [],
          "expected": [
            {
              "id": 1,
              "value": 10
            }
          ]
        },
        {
          "session": "a",
          "action": "query",
          "sql": "UPDATE bga_v35 SET value = $1 WHERE id = $2",
          "params": [
            11,
            1
          ],
          "expect_affected": 1
        },
        {
          "session": "a",
          "action": "commit"
        },
        {
          "session": "b",
          "action": "query",
          "sql": "UPDATE bga_v35 SET value = $1 WHERE id = $2",
          "params": [
            11,
            1
          ],
          "expect_affected": 1
        },
        {
          "session": "b",
          "action": "commit"
        }
      ],
      "verify": [
        {
          "sql": "SELECT id, value FROM bga_v35  ORDER BY id",
          "expected": [
            {
              "id": 1,
              "value": 11
            }
          ]
        }
      ]
    },
